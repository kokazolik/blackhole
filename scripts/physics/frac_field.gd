class_name FracField
extends RefCounted
## Поле, в котором живут куски: тяготение, газ, атмосфера, свет.
## Движок разрушения о мире знает только это. Каждый этап даёт своё поле
## (гигант — тяготение и диск вокруг него; другие этапы — своё).


## Ускорение от тяготения (и сил системы отсчёта) в точке p при скорости v.
func accel(_p: Vector2, _v: Vector2) -> Vector2:
	return Vector2.ZERO


## Ускорение, что рвёт тело (для нагрузки на швы). Обычно то же, что
## accel; поле может оставить в нём только главный центр тяготения.
func stress_accel(p: Vector2, v: Vector2) -> Vector2:
	return accel(p, v)


## Скорость газа в точке. inflow — темп дрейфа внутрь (растёт с возрастом облака).
func gas_v(_p: Vector2, _inflow: float) -> Vector2:
	return Vector2.ZERO


## Плотность газа: 1 — обычный диск, в атмосфере во много раз больше.
func gas_rho(_p: Vector2) -> float:
	return 0.0


## Насколько точка в атмосфере, 0..1 (напор воздуха, нагрев трением).
func atm(_p: Vector2) -> float:
	return 0.0


## Кусок радиуса rad в точке p утонул (коснулся поверхности).
func sunk(_p: Vector2, _rad: float) -> bool:
	return false


## Кусок ушёл из поля (за сферу Хилла): тихо забираем его массу.
func lost(_p: Vector2) -> bool:
	return false


## Освещённость: 1 — на свету, ~0 — в тени.
func shade(_p: Vector2) -> float:
	return 1.0


## Откуда свет (единичный вектор к звезде).
func light_dir(_p: Vector2) -> Vector2:
	return Vector2(-1.0, 0.0)


## Растяжение приливом в точке: разность ускорений на единицу длины вдоль
## линии на центр тяготения (у точечной массы 2GM/r³).
func tide(_p: Vector2) -> float:
	return 0.0


## Характерная скорость (круговая у поверхности): мерка для напора и ударов.
func v_ref() -> float:
	return 100.0
